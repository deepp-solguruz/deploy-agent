{
    "name": "devswarm-vscode",
    "displayName": "AI Developer Swarm",
    "description": "Submit tasks to the AI Developer Swarm and approve file changes",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "devswarm.submitTask",
                "title": "Dev Swarm: Submit Task"
            },
            {
                "command": "devswarm.viewFiles",
                "title": "Dev Swarm: View Generated Files"
            },
            {
                "command": "devswarm.rollback",
                "title": "Dev Swarm: Rollback Last Change"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "20.x",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "ws": "^8.18.0",
        "@types/ws": "^8.5.13"
    }
}